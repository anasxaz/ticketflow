<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_TicketFlow"
                  targetNamespace="http://ticketflow.com/bpmn"
                  exporter="Camunda Modeler"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:process id="ticket-lifecycle" name="Cycle de vie d'un ticket" isExecutable="true">

    <bpmn:startEvent id="StartEvent_TicketCreated" name="Ticket créé">
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 11.5 : tri humain si le LLM n'etait pas sur (ou en panne) -->
    <bpmn:exclusiveGateway id="Gateway_NeedsReview" name="Tri humain ?" default="Flow_NoReview">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NeedsReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Triage" name="Trier le ticket">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="triage-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApplyTriage</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_ApplyTriage" name="Appliquer le tri">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-triage" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApplyTriage</bpmn:incoming>
      <bpmn:outgoing>Flow_TriageDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Join">
      <bpmn:incoming>Flow_NoReview</bpmn:incoming>
      <bpmn:incoming>Flow_TriageDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAssign</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AssignAgent" name="Assigner un agent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assign-agent" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAssign</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWait</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Saga : si aucun agent n'est disponible → compensation -->
    <bpmn:boundaryEvent id="Error_NoAgentBoundary" name="Aucun agent" attachedToRef="Task_AssignAgent">
      <bpmn:outgoing>Flow_ToReject</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_NoAgent" errorRef="Error_NoAgent" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Reject" name="Rejeter le ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-ticket" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Rejected" name="Rejeté">
      <bpmn:incoming>Flow_ToRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:receiveTask id="Task_WaitResolution" name="Attendre la résolution" messageRef="Message_TicketResolved">
      <bpmn:incoming>Flow_ToWait</bpmn:incoming>
      <bpmn:incoming>Flow_Requalified</bpmn:incoming>
      <bpmn:outgoing>Flow_ToResolved</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Requalification : l'agent change la priorite -> on annule l'attente (et son timer) puis on la relance avec le nouveau SLA -->
    <bpmn:boundaryEvent id="Event_PriorityChanged" name="Priorité modifiée" attachedToRef="Task_WaitResolution">
      <bpmn:outgoing>Flow_Requalified</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_PriorityChanged" messageRef="Message_PriorityChanged" />
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="Timer_SLA" name="SLA dépassé" attachedToRef="Task_WaitResolution">
      <bpmn:outgoing>Flow_ToEscalate</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_SLA">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=slaDuration</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Escalate" name="Escalader le ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate-ticket" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEscalate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEscalated</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Resolved" name="Résolu">
      <bpmn:incoming>Flow_ToResolved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Escalated" name="Escaladé">
      <bpmn:incoming>Flow_ToEscalated</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="StartEvent_TicketCreated" targetRef="Gateway_NeedsReview" />
    <bpmn:sequenceFlow id="Flow_NeedsReview" name="Oui" sourceRef="Gateway_NeedsReview" targetRef="Task_Triage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=needsReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoReview" name="Non" sourceRef="Gateway_NeedsReview" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToApplyTriage" sourceRef="Task_Triage" targetRef="Task_ApplyTriage" />
    <bpmn:sequenceFlow id="Flow_TriageDone" sourceRef="Task_ApplyTriage" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToAssign" sourceRef="Gateway_Join" targetRef="Task_AssignAgent" />
    <bpmn:sequenceFlow id="Flow_ToWait" sourceRef="Task_AssignAgent" targetRef="Task_WaitResolution" />
    <bpmn:sequenceFlow id="Flow_ToReject" sourceRef="Error_NoAgentBoundary" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_ToRejected" sourceRef="Task_Reject" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_ToResolved" sourceRef="Task_WaitResolution" targetRef="EndEvent_Resolved" />
    <bpmn:sequenceFlow id="Flow_ToEscalate" sourceRef="Timer_SLA" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_Requalified" sourceRef="Event_PriorityChanged" targetRef="Task_WaitResolution" />
    <bpmn:sequenceFlow id="Flow_ToEscalated" sourceRef="Task_Escalate" targetRef="EndEvent_Escalated" />
  </bpmn:process>

  <bpmn:message id="Message_TicketResolved" name="ticket-resolved">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=ticketId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_PriorityChanged" name="priority-changed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=ticketId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:error id="Error_NoAgent" name="Aucun agent disponible" errorCode="NO_AGENT" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ticket-lifecycle">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_TicketCreated">
        <dc:Bounds x="152" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="142" y="285" width="57" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Assign" bpmnElement="Task_AssignAgent">
        <dc:Bounds x="640" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ErrorNoAgent" bpmnElement="Error_NoAgentBoundary">
        <dc:Bounds x="682" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="612" y="315" width="62" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reject" bpmnElement="Task_Reject">
        <dc:Bounds x="640" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndRejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="682" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="683" y="565" width="34" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Wait" bpmnElement="Task_WaitResolution">
        <dc:Bounds x="820" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PriorityChanged" bpmnElement="Event_PriorityChanged">
        <dc:Bounds x="892" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="935" y="180" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_TimerSLA" bpmnElement="Timer_SLA">
        <dc:Bounds x="862" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="902" y="315" width="66" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Escalate" bpmnElement="Task_Escalate">
        <dc:Bounds x="820" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndResolved" bpmnElement="EndEvent_Resolved">
        <dc:Bounds x="1012" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1012" y="285" width="36" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEscalated" bpmnElement="EndEvent_Escalated">
        <dc:Bounds x="1012" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1006" y="445" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_ToAssign" bpmnElement="Flow_ToAssign">
        <di:waypoint x="615" y="260" />
        <di:waypoint x="640" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToWait" bpmnElement="Flow_ToWait">
        <di:waypoint x="760" y="260" />
        <di:waypoint x="820" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToReject" bpmnElement="Flow_ToReject">
        <di:waypoint x="700" y="318" />
        <di:waypoint x="700" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToRejected" bpmnElement="Flow_ToRejected">
        <di:waypoint x="700" y="460" />
        <di:waypoint x="700" y="522" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToResolved" bpmnElement="Flow_ToResolved">
        <di:waypoint x="940" y="260" />
        <di:waypoint x="1012" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToEscalate" bpmnElement="Flow_ToEscalate">
        <di:waypoint x="880" y="318" />
        <di:waypoint x="880" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Requalified" bpmnElement="Flow_Requalified">
        <di:waypoint x="910" y="202" />
        <di:waypoint x="910" y="170" />
        <di:waypoint x="850" y="170" />
        <di:waypoint x="850" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToEscalated" bpmnElement="Flow_ToEscalated">
        <di:waypoint x="940" y="420" />
        <di:waypoint x="1012" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Shape_GatewayNeedsReview" bpmnElement="Gateway_NeedsReview" isMarkerVisible="true">
        <dc:Bounds x="225" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="215" y="292" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Triage" bpmnElement="Task_Triage">
        <dc:Bounds x="300" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ApplyTriage" bpmnElement="Task_ApplyTriage">
        <dc:Bounds x="450" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GatewayJoin" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <dc:Bounds x="565" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_ToGateway" bpmnElement="Flow_ToGateway">
        <di:waypoint x="188" y="260" />
        <di:waypoint x="225" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NeedsReview" bpmnElement="Flow_NeedsReview">
        <di:waypoint x="250" y="235" />
        <di:waypoint x="250" y="100" />
        <di:waypoint x="300" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="256" y="160" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_NoReview" bpmnElement="Flow_NoReview">
        <di:waypoint x="275" y="260" />
        <di:waypoint x="565" y="260" />
        <bpmndi:BPMNLabel><dc:Bounds x="410" y="242" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ToApplyTriage" bpmnElement="Flow_ToApplyTriage">
        <di:waypoint x="420" y="100" />
        <di:waypoint x="450" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_TriageDone" bpmnElement="Flow_TriageDone">
        <di:waypoint x="570" y="100" />
        <di:waypoint x="590" y="100" />
        <di:waypoint x="590" y="235" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
